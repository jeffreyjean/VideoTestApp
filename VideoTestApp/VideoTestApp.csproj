<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Bundle WPF's native DLLs into the single-file exe so it can't break if loose DLLs go missing. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- Media is copied on build for local runs, but not on publish: the published exe ships alone. -->
    <None Include="..\Media\**\*" LinkBase="Media" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" ExcludeFromSingleFile="true"/>
  </ItemGroup>
</Project>
